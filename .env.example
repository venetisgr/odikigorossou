# ── LLM: οποιοσδήποτε πάροχος με OpenAI-compatible /chat/completions ─────────────────────────
LLM_BASE_URL=https://api.tensorx.ai/v1      # «fake» = λειτουργία επίδειξης χωρίς μοντέλο
LLM_API_KEY=                                # χωρίς κλειδί λειτουργεί μόνο η αναζήτηση διατάξεων
LLM_MODEL=z-ai/glm-5.3-flash                # συντάκτης της απάντησης
# LLM_ROUTER_MODEL=                         # planner + επιλογή άρθρων (προεπιλογή: το LLM_MODEL)
# LLM_EXTRA_BODY={"reasoning_effort":"high"}        # επιπλέον πεδία στο αίτημα του συντάκτη (JSON)
# LLM_ROUTER_EXTRA_BODY={"reasoning_effort":"low"}  # το ίδιο για planner/επιλογή
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=8000
# LLM_ROUTER_MAX_TOKENS=4000
# LLM_TIMEOUT=180

# ── Ευρετήριο και ανάκτηση ───────────────────────────────────────────────────────────────────
# DIKIGOROS_INDEX=data/index.db
# MAX_SOURCES=12            # πόσα άρθρα το πολύ δίνονται στον συντάκτη
# MAX_CANDIDATES=40         # πόσα υποψήφια βλέπει ο επιλογέας
# CONTEXT_CHARS=120000      # συνολικό μέγεθος των συνημμένων κειμένων
# HISTORY_TURNS=4           # πόσες προηγούμενες ανταλλαγές συνοδεύουν κάθε ερώτηση

# ── Ζωντανός έλεγχος (ισχύς σε ημερομηνία, ιστορικό) στο αρχείο Global law της Lexifina ──────
# LAW_API_ENABLED=1
# LAW_API_BASE_URL=https://global-law.lexifina.com/v1
# LAW_API_KEY=              # χωρίς κλειδί: 10 κλήσεις/λεπτό και 100/ημέρα ανά διεύθυνση
# LAW_API_PER_MINUTE=
# LAW_API_PER_DAY=

# ── Πρόσβαση ─────────────────────────────────────────────────────────────────────────────────
ACCESS_CODE=                # αν οριστεί, το site ζητά αυτόν τον κωδικό
# ASK_PER_HOUR=40           # ερωτήσεις ανά διεύθυνση την ώρα (0 = χωρίς όριο)
# MAX_QUESTION_CHARS=6000
# CORS_ORIGINS=             # μόνο αν το frontend σερβίρεται από άλλο domain
